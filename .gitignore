backend/venv/
backend/env/
backend/ENV/
backend/__pycache__/
backend/**/__pycache__/
backend/*/**/__pycache__/
*.py[cod]
*$py.class

# Backend Environment Files
backend/.env
backend/.env.local
backend/.env.*.local
!backend/.env.example

